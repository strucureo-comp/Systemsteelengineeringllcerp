{
    "name": "bridgebreak-backend",
    "version": "1.0.0",
    "description": "BridgeBreak ERP Backend API",
    "main": "server.js",
    "scripts": {
        "dev": "node --watch server.js",
        "start": "node server.js",
        "seed": "node seed.js",
        "db:clear": "node scripts/clear-database.js",
        "db:reset": "node scripts/clear-database.js --seed",
        "db:fresh": "./scripts/reset-fresh.sh",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "storage:maintenance": "node jobs/storageMaintenance.js",
        "storage:test": "node test-upload.js",
        "security:test": "node test-security.js",
        "email:test": "node test-email.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "exceljs": "^4.3.0",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.3.2",
        "express-validator": "^7.3.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.1.0",
        "multer": "^2.1.1",
        "pdfkit": "^0.13.0",
        "sharp": "^0.34.5",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^13.0.0",
        "xss-clean": "^0.1.4"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/supertest": "^7.2.0",
        "jest": "^30.3.0",
        "supertest": "^7.2.2"
    }
}
