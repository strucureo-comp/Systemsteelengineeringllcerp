# ═══════════════════════════════════════
# PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════

# ═══════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=/api/backend

# ═══════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════
MONGODB_URI=mongodb://admin:CHANGE_THIS_PASSWORD@mongodb:27017/bridgebreak?authSource=admin
MONGODB_DB=bridgebreak

# MongoDB Docker credentials
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_PASSWORD

# ═══════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARACTERS

# ═══════════════════════════════════════
# BACKEND SERVER
# ═══════════════════════════════════════
PORT=4000
CORS_ORIGIN=https://your-domain.com

# ═══════════════════════════════════════
# FILE UPLOADS
# ═══════════════════════════════════════
UPLOAD_ROOT=./uploads
MAX_UPLOAD_SIZE_MB=20

# ═══════════════════════════════════════
# EMAIL / SMTP CONFIGURATION
# ═══════════════════════════════════════
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=erp@your-domain.com
SMTP_PASS=CHANGE_THIS_PASSWORD
SMTP_FROM=erp@your-domain.com
COMPANY_NAME=Your Company Name
FRONTEND_URL=https://your-domain.com

# ═══════════════════════════════════════
# DOCKER CONFIGURATION
# ═══════════════════════════════════════
API_PROXY_TARGET=http://backend:4000

# ═══════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════
# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# ═══════════════════════════════════════
# MONITORING & LOGGING
# ═══════════════════════════════════════
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ═══════════════════════════════════════
# BACKUP
# ═══════════════════════════════════════
BACKUP_DIR=/backup
BACKUP_RETENTION_DAYS=30

# ═══════════════════════════════════════
# EXTERNAL APIs (Optional)
# ═══════════════════════════════════════
# Currency Exchange Rates API
# Free: https://open.er-api.com/v6/latest/USD
# Paid: https://v6.exchangerate-api.com/v6/YOUR-API-KEY/latest/USD
FX_API_URL=https://open.er-api.com/v6/latest/USD

# API Ninjas (for additional data enrichment - optional)
# Get your key at: https://api-ninjas.com/
API_NINJAS_KEY=

# ═══════════════════════════════════════
# TESTING (Optional)
# ═══════════════════════════════════════
MONGODB_URI_TEST=mongodb://admin:CHANGE_THIS_PASSWORD@mongodb:27017/bridgebreak_test?authSource=admin

# ═══════════════════════════════════════
# NOTES
# ═══════════════════════════════════════
# 1. Replace ALL "CHANGE_THIS" values before deployment
# 2. Generate secure JWT_SECRET using crypto.randomBytes
# 3. Use strong passwords for MongoDB
# 4. Configure SMTP with your email provider
# 5. Set correct domain names for CORS_ORIGIN and FRONTEND_URL
# 6. Keep this file secure and never commit to version control
# 7. External APIs are optional - system works without them
