# ═══════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/backend

# ═══════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════
MONGODB_URI=mongodb://localhost:27017/bridgebreak
MONGODB_DB=bridgebreak

# ═══════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ═══════════════════════════════════════
# BACKEND SERVER
# ═══════════════════════════════════════
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ═══════════════════════════════════════
# FILE UPLOADS
# ═══════════════════════════════════════
UPLOAD_ROOT=./uploads
MAX_UPLOAD_SIZE_MB=20

# ═══════════════════════════════════════
# EMAIL / SMTP CONFIGURATION
# ═══════════════════════════════════════
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=erp@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=erp@yourdomain.com
COMPANY_NAME=BridgeBreak ERP
FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════
# EXTERNAL APIs (Optional)
# ═══════════════════════════════════════
# Currency Exchange Rates API (uses free API by default)
FX_API_URL=https://open.er-api.com/v6/latest/USD

# API Ninjas (for additional data enrichment - optional)
# Get your key at: https://api-ninjas.com/
API_NINJAS_KEY=

# ═══════════════════════════════════════
# TESTING (Optional)
# ═══════════════════════════════════════
MONGODB_URI_TEST=mongodb://localhost:27017/bridgebreak_test
